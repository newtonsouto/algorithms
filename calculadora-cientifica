                        break;
                    case 18: // pow 2
                        num1 = ler_double("Digite o expoente (x): ");
                        resultado = calcular_unario_avancado(16, num1, &erro_mat, tipo_op_str);
                        break;
                    case 19: // pow 10
                        num1 = ler_double("Digite o expoente (x): ");
                        resultado = calcular_unario_avancado(18, num1, &erro_mat, tipo_op_str);
                        break;
                    case 20: // Valor Absoluto
                        num1 = ler_double("Digite o numero (x): ");
                        resultado = calcular_unario_avancado(10, num1, &erro_mat, tipo_op_str);
                        break;
                    case 21: // Teto
                        num1 = ler_double("Digite o numero (x): ");
                        resultado = calcular_unario_avancado(11, num1, &erro_mat, tipo_op_str);
                        break;
                    case 22: // Piso
                        num1 = ler_double("Digite o numero (x): ");
                        resultado = calcular_unario_avancado(12, num1, &erro_mat, tipo_op_str);
                        break;
                    case 23: // Seno Hiperbolico
                        num1 = ler_double("Digite o numero (x): ");
                        resultado = calcular_unario_avancado(13, num1, &erro_mat, tipo_op_str);
                        break;
                    case 24: // Cosseno Hiperbolico
                        num1 = ler_double("Digite o numero (x): ");
                        resultado = calcular_unario_avancado(14, num1, &erro_mat, tipo_op_str);
                        break;
                    case 25: // Tangente Hiperbolica
                        num1 = ler_double("Digite o numero (x): ");
                        resultado = calcular_unario_avancado(15, num1, &erro_mat, tipo_op_str);
                        break;
                        
                    default: printf("Opcao de operacao avancada invalida.\n");
                }
                
                // Tratamento de erro para funções unárias
                if (op_avancada >= 7 && op_avancada <= 25) { 
                    if (erro_mat == 0) {
                        printf("Resultado (%s): %.4f\n", tipo_op_str, resultado);
                    } else if (erro_mat == 1) {
                        printf("ERRO MATEMATICO: Valor fora do dominio de ArcSen/ArcCos (deve ser entre -1 e 1).\n");
                    } else if (erro_mat == 2) {
                        printf("ERRO MATEMATICO: Logaritmo indefinido para numeros nao positivos.\n");
                    } else if (erro_mat == 3) {
                        printf("ERRO MATEMATICO: Raiz quadrada de numero negativo.\n");
                    } else if (erro_mat == -1) {
                        printf("Opcao de operacao avancada invalida.\n");
                    }
                }
                break;
            }

            case 3: {
                // Matrizes
                printf("\n--- OPERACOES COM MATRIZES 3x3 ---\n");
                printf("1. Soma de Matrizes\n2. Multiplicacao de Matrizes\n");
                printf("Escolha a operacao: ");
                
                int op_matriz;
                if (scanf("%d", &op_matriz) != 1) {
                    printf("Opcao invalida.\n");
                    limpar_buffer();
                    break;
                }
                
                int MatrizA[TAMANHO_MATRIZ][TAMANHO_MATRIZ];
                int MatrizB[TAMANHO_MATRIZ][TAMANHO_MATRIZ];
                int MatrizResultado[TAMANHO_MATRIZ][TAMANHO_MATRIZ];
                
                printf("\n--- ENTRADA DE DADOS ---\n");
                ler_matriz(MatrizA, "A");
                ler_matriz(MatrizB, "B");
                
                printf("\nMatriz A:\n");
                imprimir_matriz(MatrizA);
                printf("\nMatriz B:\n");
                imprimir_matriz(MatrizB);
                
                printf("\n--- RESULTADO ---\n");
                switch (op_matriz) {
                    case 1:
                        somar_matrizes(MatrizA, MatrizB, MatrizResultado);
                        printf("Matriz Resultado (A + B):\n");
                        imprimir_matriz(MatrizResultado);
                        break;
                    case 2:
                        multiplicar_matrizes(MatrizA, MatrizB, MatrizResultado);
                        printf("Matriz Resultado (A * B):\n");
                        imprimir_matriz(MatrizResultado);
                        break;
                    default: 
                        printf("Opcao de operacao com matrizes invalida.\n");
                        break;
                }
                break;
            }

            case 4:
                mostrar_historico();
                break;

            case 5:
                salvar_historico_arquivo();
                break;

            case 0:
                printf("Saindo da calculadora. Ate logo!\n");
                break;

            default:
                printf("Opcao invalida. Tente novamente.\n");
        }
    } while (opcao != 0);

    return 0;
}
