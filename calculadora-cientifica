// Funções de utilidade
void limpar_buffer() {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}

double ler_double(const char *prompt) {
    double valor;
    int resultado;
    do {
        printf("%s", prompt);
        resultado = scanf("%lf", &valor);

        if (resultado != 1) {
            printf("Entrada invalida. Por favor, digite um numero.\n");
            limpar_buffer();
        }
    } while (resultado != 1);
    return valor;
}

int ler_array_entrada(double array[]) {
    int tamanho = 0;
    printf("Quantos numeros voce deseja inserir (max %d)? ", MAX_ELEMENTOS_ARRAY);
    if (scanf("%d", &tamanho) != 1 || tamanho <= 0 || tamanho > MAX_ELEMENTOS_ARRAY) {
        printf("Tamanho invalido ou excede o maximo (%d). Usando tamanho 0.\n", MAX_ELEMENTOS_ARRAY);
        limpar_buffer();
        return 0;
    }

    printf("Digite os %d numeros:\n", tamanho);
    for (int i = 0; i < tamanho; i++) {
        array[i] = ler_double("");
    }
    return tamanho;
}

// Funções de histórico

void adicionar_historico(const char *tipo, double a, double b, double resultado, int num_operandos) {
    int indice = contador_historico % MAX_HISTORICO;
    strncpy(historico[indice].tipo, tipo, MAX_OPERACAO_NOME - 1);
    historico[indice].tipo[MAX_OPERACAO_NOME - 1] = '\0';
    historico[indice].a = a;
    historico[indice].b = b;
    historico[indice].resultado = resultado;
    historico[indice].id = proximo_id++;
    historico[indice].num_operandos = num_operandos;
    contador_historico++;
}

void mostrar_historico() {
    // mostrar historico
    printf("\n--- HISTORICO DE OPERACOES ---\n");
    int inicio = (contador_historico > MAX_HISTORICO) ? (contador_historico - MAX_HISTORICO) : 0;
    int num_mostrar = (contador_historico > MAX_HISTORICO) ? MAX_HISTORICO : contador_historico;

    if (num_mostrar == 0) {
        printf("Nenhuma operacao registrada.\n");
        return;
    }

    for (int i = 0; i < num_mostrar; i++) {
        int indice = (inicio + i) % MAX_HISTORICO;
        Operacao op = historico[indice];
        printf("ID: %d | Tipo: %s | ", op.id, op.tipo);

        if (op.num_operandos == 2) {
            printf("Operandos: %.2f e %.2f | ", op.a, op.b);
        } else if (op.num_operandos == 1) {
             printf("Operando: %.2f | ", op.a);
        } else {
             printf("Operando: N/A | ");
        }

        printf("Resultado: %.4f\n", op.resultado);
    }
    printf("----------------------------\n");
}

void salvar_historico_arquivo() {
    // salvando historico
    FILE *arquivo = fopen("historico_calculadora.csv", "w");

    if (arquivo == NULL) {
        printf("ERRO: Nao foi possivel abrir/criar o arquivo de historico.\n");
        return;
    }

    fprintf(arquivo, "ID;Tipo;Operando A;Operando B;Resultado\n");
    int inicio = (contador_historico > MAX_HISTORICO) ? (contador_historico - MAX_HISTORICO) : 0;
    int num_mostrar = (contador_historico > MAX_HISTORICO) ? MAX_HISTORICO : contador_historico;

    if (num_mostrar == 0) {
        printf("Historico vazio. Arquivo criado, mas sem dados.\n");
        fclose(arquivo);
        return;
    }

    for (int i = 0; i < num_mostrar; i++) {
        int indice = (inicio + i) % MAX_HISTORICO;
        Operacao op = historico[indice];

        fprintf(arquivo, "%d;%s;%.4f;%.4f;%.4f\n",
                op.id,
                op.tipo,
                op.a,
                op.b,
                op.resultado);
    }

    fclose(arquivo);
    printf("\nHistorico salvo com sucesso em 'historico_calculadora.csv'!\n");
}


// Operações basicas

double calcular_soma(double a, double b) {
    double resultado = a + b;
    adicionar_historico("Soma", a, b, resultado, 2);
    return resultado;
}

double calcular_subtracao(double a, double b) {
    double resultado = a - b;
    adicionar_historico("Subtracao", a, b, resultado, 2);
    return resultado;
}

double calcular_multiplicacao(double a, double b) {
    double resultado = a * b;
    adicionar_historico("Multiplicacao", a, b, resultado, 2);
    return resultado;
}

double calcular_divisao(double a, double b, int *erro_divisao_zero) {
    if (b == 0) {
        *erro_divisao_zero = 1;
        return 0.0;
    }
    *erro_divisao_zero = 0;
    double resultado = a / b;
    adicionar_historico("Divisao", a, b, resultado, 2);
    return resultado;
}


// Operações avançadas

double calcular_unario_avancado(int op_code, double num1, int *erro_matematico, char *tipo_op_out) {
    *erro_matematico = 0;
    double resultado = 0.0;
    
    // Converte de radianos para graus se for entrada trigonométrica
    double angulo_graus = num1; 
    
    switch (op_code) {
        case 1: strcpy(tipo_op_out, "Seno"); num1 = angulo_graus * (M_PI / 180.0); resultado = sin(num1); break;
        case 2: strcpy(tipo_op_out, "Cosseno"); num1 = angulo_graus * (M_PI / 180.0); resultado = cos(num1); break;
        case 3: strcpy(tipo_op_out, "Tangente"); num1 = angulo_graus * (M_PI / 180.0); resultado = tan(num1); break;
        case 4: strcpy(tipo_op_out, "ArcSen"); if (fabs(num1) > 1) { *erro_matematico = 1; return 0; } resultado = asin(num1) * (180.0 / M_PI); break;
        case 5: strcpy(tipo_op_out, "ArcCos"); if (fabs(num1) > 1) { *erro_matematico = 1; return 0; } resultado = acos(num1) * (180.0 / M_PI); break;
        case 6: strcpy(tipo_op_out, "ArcTan"); resultado = atan(num1) * (180.0 / M_PI); break;
        case 7: strcpy(tipo_op_out, "Log Nat"); if (num1 <= 0) { *erro_matematico = 2; return 0; } resultado = log(num1); break;
        case 8: strcpy(tipo_op_out, "Log Base 10"); if (num1 <= 0) { *erro_matematico = 2; return 0; } resultado = log10(num1); break;
        case 9: strcpy(tipo_op_out, "e^x"); resultado = exp(num1); break;
        case 10: strcpy(tipo_op_out, "Valor Abs"); resultado = fabs(num1); break;
        case 11: strcpy(tipo_op_out, "Teto (ceil)"); resultado = ceil(num1); break;
        case 12: strcpy(tipo_op_out, "Piso (floor)"); resultado = floor(num1); break;
        case 13: strcpy(tipo_op_out, "Sen Hip"); resultado = sinh(num1); break;
        case 14: strcpy(tipo_op_out, "Cos Hip"); resultado = cosh(num1); break;
        case 15: strcpy(tipo_op_out, "Tan Hip"); resultado = tanh(num1); break;
        case 16: strcpy(tipo_op_out, "2^x"); resultado = pow(2, num1); break;
        case 17: strcpy(tipo_op_out, "Raiz Cubica"); resultado = cbrt(num1); break;
        case 18: strcpy(tipo_op_out, "10^x"); resultado = pow(10, num1); break;
        case 19: strcpy(tipo_op_out, "Raiz Quad"); if (num1 < 0) { *erro_matematico = 3; return 0; } resultado = sqrt(num1); break;
        default: 
            strcpy(tipo_op_out, "Opcao Invalida");
            *erro_matematico = -1; // opção inválida
            return 0;
    }
    
    // Registro no historico
    
    if (*erro_matematico == 0) {
        adicionar_historico(tipo_op_out, angulo_graus, 0.0, resultado, 1);
    }
    
    return resultado;
}

// Funções binárias/especiais

double calcular_potencia(double base, double expoente) {
    double resultado = pow(base, expoente);
    adicionar_historico("Potencia (a^b)", base, expoente, resultado, 2);
    return resultado;
}

long long calcular_fatorial(int n) {
    if (n < 0 || n > 20) {
        printf("ERRO: Fatorial de negativo ou muito grande.\n");
        return 0;
    }
    if (n == 0) return 1;
    long long resultado = 1;
    for (int i = 2; i <= n; i++) {
        resultado *= i;
    }
    adicionar_historico("Fatorial", (double)n, 0.0, (double)resultado, 1);
    return resultado;
}

void ordenar_array(double array[], int tamanho) {
    // ordenação do array
    for (int i = 0; i < tamanho - 1; i++) {
        for (int j = 0; j < tamanho - 1 - i; j++) {
            if (array[j] > array[j + 1]) {
                double temp = array[j];
                array[j] = array[j + 1];
                array[j + 1] = temp;
            }
        }
    }
}

void calcular_media_array(double array[], int tamanho) {
    // calculando media
    if (tamanho <= 0) { printf("ERRO: Array vazio.\n"); return; }
    double soma = 0.0;
    for (int i = 0; i < tamanho; i++) { soma += array[i]; }
    double media = soma / tamanho;
    printf("Resultado: Media = %.4f\n", media);
    adicionar_historico("Media (Array)", media, (double)tamanho, media, 0);
}

void calcular_mediana_array(double array[], int tamanho) {
    // calcular mediana
    if (tamanho <= 0) { printf("ERRO: Array vazio.\n"); return; }
    double copia[tamanho];
    for(int i = 0; i < tamanho; i++) { copia[i] = array[i]; }
    ordenar_array(copia, tamanho);
    double mediana;
    if (tamanho % 2 != 0) {
        mediana = copia[tamanho / 2];
    } else {
        mediana = (copia[tamanho / 2 - 1] + copia[tamanho / 2]) / 2.0;
    }
    printf("Resultado: Mediana = %.4f\n", mediana);
    adicionar_historico("Mediana (Array)", mediana, (double)tamanho, mediana, 0);
}

int calcular_mdc(int a, int b) {
    // calculo mdc
    int original_a = abs(a);
    int original_b = abs(b);
    int mdc_val = abs(a);
    int b_val = abs(b);
    while (b_val != 0) {
        int temp = b_val;
        b_val = mdc_val % b_val;
        mdc_val = temp;
    }
    adicionar_historico("MDC", (double)original_a, (double)original_b, (double)mdc_val, 2);
    return mdc_val;
}

int calcular_mmc(int a, int b) {
    // calculo mmc
    if (a == 0 || b == 0) { printf("AVISO: MMC de zero e zero.\n"); adicionar_historico("MMC", (double)a, (double)b, 0.0, 2); return 0; }
    int mdc = calcular_mdc(a, b);
    long long produto = (long long)abs(a) * abs(b);
    int resultado = (int) (produto / mdc);
    adicionar_historico("MMC", (double)a, (double)b, (double)resultado, 2);
    return resultado;
}

// Operação com matrizes

void ler_matriz(int M[TAMANHO_MATRIZ][TAMANHO_MATRIZ], const char *nome) {
    printf("Digite os %d elementos da Matriz %s (por linha):\n", TAMANHO_MATRIZ * TAMANHO_MATRIZ, nome);
    for (int i = 0; i < TAMANHO_MATRIZ; i++) {
        for (int j = 0; j < TAMANHO_MATRIZ; j++) {
            printf("Elemento [%d][%d]: ", i + 1, j + 1);
            double valor_lido;
            if (scanf("%lf", &valor_lido) != 1) {
                printf("Entrada invalida. Usando 0.\n");
                limpar_buffer();
                valor_lido = 0;
            }
            M[i][j] = (int)valor_lido;
        }
    }
}

void imprimir_matriz(int M[TAMANHO_MATRIZ][TAMANHO_MATRIZ]) {
    for (int i = 0; i < TAMANHO_MATRIZ; i++) {
        printf("|");
        for (int j = 0; j < TAMANHO_MATRIZ; j++) {
            printf(" %3d ", M[i][j]);
        }
        printf("|\n");
    }
}

void somar_matrizes(int A[TAMANHO_MATRIZ][TAMANHO_MATRIZ], int B[TAMANHO_MATRIZ][TAMANHO_MATRIZ], int C[TAMANHO_MATRIZ][TAMANHO_MATRIZ]) {
    int resultado_soma = 0;
    for (int i = 0; i < TAMANHO_MATRIZ; i++) {
        for (int j = 0; j < TAMANHO_MATRIZ; j++) {
            C[i][j] = A[i][j] + B[i][j];
            resultado_soma += C[i][j];
        }
    }
    adicionar_historico("Soma Matrizes 3x3", 0.0, 0.0, (double)resultado_soma, 0);
}

void multiplicar_matrizes(int A[TAMANHO_MATRIZ][TAMANHO_MATRIZ], int B[TAMANHO_MATRIZ][TAMANHO_MATRIZ], int C[TAMANHO_MATRIZ][TAMANHO_MATRIZ]) {
    int resultado_mult = 0;
    for (int i = 0; i < TAMANHO_MATRIZ; i++) {
        for (int j = 0; j < TAMANHO_MATRIZ; j++) {
            C[i][j] = 0;
            for (int k = 0; k < TAMANHO_MATRIZ; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
            resultado_mult += C[i][j];
        }
    }
    adicionar_historico("Multiplicacao Matrizes 3x3", 0.0, 0.0, (double)resultado_mult, 0);
}


